# Copy to .env and fill in. Never commit .env.

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Required. Domain the API is served from, comma separated, no https://
DJANGO_ALLOWED_HOSTS=api.example.com

# Required. Where the frontend is hosted, with https://
CORS_ALLOWED_ORIGINS=https://app.example.com

# Needed for the Django admin login. Where the API is served, with https://
CSRF_TRUSTED_ORIGINS=https://api.example.com

# Number of proxies in front of the app. Used to find the real client IP for the login limit.
NUM_PROXIES=1

# Host port for the API.
BACKEND_PORT=8000
